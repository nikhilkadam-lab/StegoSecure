
# Flask Security
SECRET_KEY=replace_with_a_secure_random_secret_key
COOKIE_SECURE=false

# AWS RDS Database
DB_HOST=your-rds-endpoint
DB_PORT=3306
DB_NAME=stego_secure
DB_USER=your_database_username
DB_PASSWORD=your_database_password

# Upload and Encrypted Storage
MAX_UPLOAD_MB=50
ENCRYPTED_STORAGE_DIR=private_storage
ENCRYPTED_IMAGE_RETENTION_DAYS=30

# AWS S3 Configuration
AWS_REGION=ap-south-1
S3_BUCKET=your-s3-bucket-name

# Razorpay Configuration
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# Email Provider
EMAIL_PROVIDER=brevo
EMAIL_FROM_NAME=StegoSecure
EMAIL_FROM_ADDRESS=no-reply@your-domain.com
BREVO_API_KEY=your_brevo_api_key

# OTP Settings
OTP_LENGTH=6
OTP_EXPIRY_MINUTES=5
OTP_RESEND_COOLDOWN=60
OTP_MAX_ATTEMPTS=5
OTP_MAX_SENDS=3
OTP_SEND_WINDOW_MINUTES=15
